{
  "name": "sistema-mottainai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lighthouse": "tsc -b && vite build --mode lighthouse",
    "lint": "eslint .",
    "lint:html": "eslint . --format html --output-file relatorio-qualidade.html",
    "test": "node --test tests/*.test.mjs && vitest run --config vitest.config.ts",
    "test:node": "node --test tests/*.test.mjs",
    "test:react": "vitest run --config vitest.config.ts",
    "preview": "vite preview",
    "serve:lhci": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "lighthouse:ci": "npm run build:lighthouse && node scripts/lighthouse-ci.cjs"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "chart.js": "^4.5.1",
    "immer": "^11.1.18",
    "jwt-decode": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "use-immer": "^0.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.1.3",
    "puppeteer": "^24.43.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.5"
  }
}
